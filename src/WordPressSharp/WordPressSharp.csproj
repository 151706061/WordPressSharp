<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>WordPressSharp</PackageId>
    <Version>2.0.0</Version>
    <Authors>Andy Brudtkuhl</Authors>
    <Description>A .NET client for the WordPress REST API.</Description>
    <PackageTags>WordPress;REST;API;CMS</PackageTags>
    <PackageProjectUrl>https://github.com/abrudtkuhl/WordPressSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/abrudtkuhl/WordPressSharp</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Rest/**/*.cs" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
